<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10.0, not the host's net8.0: this project is never loaded into SwarmUI's extension
         AssemblyLoadContext (SwarmUI.extension.props forces net8.0 for that reason alone), it just runs
         standalone under `dotnet test`, and this box has only the net10.0 shared runtime installed. A net10.0
         test host referencing a net8.0 library/SwarmUI.dll is a normal backward-compatible TFM consumption. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Hartsy.Extensions.AudioLab.Tests</AssemblyName>
    <RootNamespace>Hartsy.Extensions.AudioLab.Tests</RootNamespace>
    <!-- Pure bridge-mapping / provider-flag tests only (see README in this folder): no live Engine, no GPU,
         no model weights. They register the built-in providers directly (AudioProviderDefinitions.RegisterAll)
         rather than going through a SwarmUI host init. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SwarmUI-AudioLab.csproj" />
    <!-- Same reasoning as the ProjectReference above: AudioEngineBridge's public surface (eg SupportsNativeStreaming)
         is plain CLR types from HartsyInference packages and SwarmUI's own JObject/Logs usage pulls in SwarmUI.dll
         metadata too, same as LLMAssistant's Tests project; this project copies it locally since nothing else here
         provides SwarmUI.dll at test-run time. -->
    <Reference Include="SwarmUI">
      <HintPath>../../../bin/live_release/SwarmUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The main project's own ItemGroup marks FreneticLLC.FreneticUtilities ExcludeAssets="runtime" because
         that project only ever runs loaded inside the SwarmUI host, which already carries the DLL (see its
         comment: "Host-provided packages ... avoids duplicate/version-skew"). That exclusion is an edge
         property of AudioLab's own graph, so it flows through the ProjectReference above as part of what
         AudioLab exposes; a `PackageReference Update` here cannot override it because Tests never has a
         direct `Include` of its own for NuGet to update: confirmed empirically, Tests' own
         obj/*.nuget.dgspec.json lists no direct dependency entry for the package at all without this. Giving
         Tests a genuine direct Include, pinned to the exact version already resolved elsewhere in the graph,
         creates its own un-excluded edge; NuGet then unions assets across both edges to the same package.
         This project runs standalone under `dotnet test`, with no host to supply the DLL, and
         SwarmUI.Utils.Logs's static constructor touches FreneticUtilities at runtime (not just at the
         metadata level the SwarmUI reference above satisfies), so the physical copy is required here. -->
    <PackageReference Include="FreneticLLC.FreneticUtilities" Version="1.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- AudioProviderRegistry is process-global static state (same hazard the engine's own Voice.Tests notes
         for Logs.SetLogger): keep test collections from this assembly running in parallel against it. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
