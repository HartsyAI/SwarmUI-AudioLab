<?xml version="1.0" encoding="utf-8"?>
<!-- DEV-MACHINE ONLY (do not commit): adds the locally-packed engine feed the "-local" pins resolve
     from. Packed via: dotnet pack HartsyInference.sln -c Release -p:VersionSuffix=alpha.48.N-local
     -o ~/.local/share/hartsy-local-nuget (see the engine repo's deploy recipe). -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="hartsy-local" value="/home/hartsy/.local/share/hartsy-local-nuget" />
  </packageSources>
</configuration>
