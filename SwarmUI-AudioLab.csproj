    <!-- Exact pin on purpose: a floating alpha.* resolves to the stale alpha.NNN-local.M builds in the hartsy-local feed (NuGet ranks the alphanumeric label above numeric ones), which broke every extension build on 2026-10-07. -->
    <PackageReference Include="HartsyInference" Version="2.0.0-alpha.270" />
    <!-- Kept at the exact same version as the HartsyInference pin above, since both come from the same engine
         repo tag and must never skew. -->
    <PackageReference Include="HartsyInference.Voice" Version="2.0.0-alpha.270" />
  </ItemGroup>

  <!-- LOCAL ENGINE DEBUGGING: prebuilt engine DLLs, not ProjectReferences (a ProjectReference would leak
       SwarmUI's global obj/output MSBuild properties into the engine projects and break their build).
       The Cli bin is the full engine closure (every HartsyInference.* assembly + private deps in one folder) —
       the Engine assembly is not emitted to its own project bin, and Engine transitively needs every modality
       assembly at runtime, so the closure is the only complete source. Same pattern SwarmUI-LLMAssistant uses.
       Build it first:
       dotnet build src/HartsyInference.Cli/HartsyInference.Cli.csproj -c Release -f net8.0 -->
  <PropertyGroup Condition="'$(UseLocalHartsy)' == 'true'">
    <HartsyCfg Condition="'$(HartsyCfg)' == '' and Exists('$(HartsyRepo)/src/HartsyInference.Cli/bin/Release/net8.0/HartsyInference.Engine.dll')">Release</HartsyCfg>
    <HartsyCfg Condition="'$(HartsyCfg)' == ''">Debug</HartsyCfg>
    <HartsyLocalBin>$(HartsyRepo)/src/HartsyInference.Cli/bin/$(HartsyCfg)/net8.0</HartsyLocalBin>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalHartsy)' == 'true'">
    <!-- The Engine is the single source of truth for load+generate; AudioLab talks only to its audio services.
         The rest are the Engine's runtime closure (it references every modality package), copied so Swarm's
         per-extension AssemblyLoadContext can resolve them. -->
    <Reference Include="HartsyInference.Engine"><HintPath>$(HartsyLocalBin)/HartsyInference.Engine.dll</HintPath><Private>true</Private></Reference>
